<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="0005-1-create-sales-table" author="andre.barbosa">
        <createTable tableName="sales">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" primaryKeyName="sales_pkey" nullable="false"/>
            </column>
            <column name="product_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_sales_product" references="products(id)"/>
            </column>
            <column name="quantity" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="unit_price" type="NUMERIC(38,2)">
                <constraints nullable="false"/>
            </column>
            <column name="sold_at" type="TIMESTAMP(6)">
                <constraints nullable="false"/>
            </column>
            <column name="active" type="BOOLEAN"/>
            <column name="creation_date" type="TIMESTAMP(6)">
                <constraints nullable="false"/>
            </column>
            <column name="modification_date" type="TIMESTAMP(6)"/>
        </createTable>
    </changeSet>

</databaseChangeLog>
