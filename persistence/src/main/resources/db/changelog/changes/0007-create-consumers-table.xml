<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="0007-1-create-consumers-table" author="andre.barbosa">
        <createTable tableName="consumers">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" primaryKeyName="consumers_pkey" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="email" type="VARCHAR(255)">
                <constraints nullable="false" unique="true" uniqueConstraintName="consumers_email_key"/>
            </column>
            <column name="password_hash" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="active" type="BOOLEAN"/>
            <column name="creation_date" type="TIMESTAMP(6)">
                <constraints nullable="false"/>
            </column>
            <column name="modification_date" type="TIMESTAMP(6)"/>
        </createTable>
    </changeSet>

</databaseChangeLog>
