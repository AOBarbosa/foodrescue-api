<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="0008-1-create-offer-orders-table" author="andre.barbosa">
        <createTable tableName="offer_orders">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" primaryKeyName="offer_orders_pkey" nullable="false"/>
            </column>
            <column name="offer_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_offer_orders_offer" references="offers(id)"/>
            </column>
            <column name="consumer_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_offer_orders_consumer" references="consumers(id)"/>
            </column>
            <column name="quantity" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="active" type="BOOLEAN"/>
            <column name="creation_date" type="TIMESTAMP(6)">
                <constraints nullable="false"/>
            </column>
            <column name="modification_date" type="TIMESTAMP(6)"/>
        </createTable>
    </changeSet>

    <changeSet id="0008-2-offer-orders-status-check" author="andre.barbosa">
        <sql>
            ALTER TABLE offer_orders ADD CONSTRAINT offer_orders_status_check
                CHECK (status IN ('RESERVED', 'CANCELLED'));
        </sql>
    </changeSet>

</databaseChangeLog>
