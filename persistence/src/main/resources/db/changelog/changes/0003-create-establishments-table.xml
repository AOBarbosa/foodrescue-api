<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="0003-1-create-establishments-table" author="andre.barbosa">
        <createTable tableName="establishments">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" primaryKeyName="establishments_pkey" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="cnpj" type="VARCHAR(255)">
                <constraints nullable="false" unique="true" uniqueConstraintName="establishments_cnpj_key"/>
            </column>
            <column name="address" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="category" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="email" type="VARCHAR(255)">
                <constraints nullable="false" unique="true" uniqueConstraintName="establishments_email_key"/>
            </column>
            <column name="password_hash" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="active" type="BOOLEAN"/>
            <column name="creation_date" type="TIMESTAMP(6)">
                <constraints nullable="false"/>
            </column>
            <column name="modification_date" type="TIMESTAMP(6)"/>
        </createTable>
    </changeSet>

    <changeSet id="0003-2-establishments-category-check" author="andre.barbosa">
        <sql>
            ALTER TABLE establishments ADD CONSTRAINT establishments_category_check
                CHECK (category IN ('BAKERY', 'RESTAURANT', 'MARKET', 'SNACK_BAR'));
        </sql>
    </changeSet>

</databaseChangeLog>
