<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="0004-1-create-products-table" author="andre.barbosa">
        <createTable tableName="products">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" primaryKeyName="products_pkey" nullable="false"/>
            </column>
            <column name="establishment_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_products_establishment" references="establishments(id)"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="category" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="original_price" type="NUMERIC(38,2)">
                <constraints nullable="false"/>
            </column>
            <column name="current_price" type="NUMERIC(38,2)">
                <constraints nullable="false"/>
            </column>
            <column name="photo_url" type="VARCHAR(255)"/>
            <column name="stock_quantity" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="expiration_date" type="DATE"/>
            <column name="active" type="BOOLEAN"/>
            <column name="creation_date" type="TIMESTAMP(6)">
                <constraints nullable="false"/>
            </column>
            <column name="modification_date" type="TIMESTAMP(6)"/>
        </createTable>
    </changeSet>

</databaseChangeLog>
