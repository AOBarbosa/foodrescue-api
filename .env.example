# Copy to .env (git-ignored) and fill in. Read by Spring Boot and docker compose.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# FORECAST_PROVIDER=gemini   # or "local" to use only the statistical forecast
# WASTE_RISK_THRESHOLD=70    # risk % above which a product is flagged as at risk (UC06)
# DISCOUNT_RISK_FACTOR=0.6              # fraction of the risk that becomes discount (UC07)
# DISCOUNT_URGENCY_BONUS=15             # extra percentage points when time is running out (UC07)
# DISCOUNT_URGENT_HOURS=4               # hours before closing that count as urgent (UC07)
# DISCOUNT_MAX_PERCENTAGE=60            # ceiling for any suggested discount (UC07)
# DISCOUNT_RECOMMENDATION_TTL_HOURS=24  # how long a pending recommendation waits (UC07)
